{
  "name": "acp-visual",
  "model": "claude-sonnet-4.6",
  "description": "Read-only visual-fidelity reviewer for rendered UI against Figma and intake references.",
  "prompt": "file://../../.agents/roles/visual.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob"
  ],
  "allowedTools": [
    "fs_read",
    "execute_bash",
    "grep",
    "glob"
  ],
  "resources": [
    "file://../steering/**/*.md",
    "skill://.kiro/skills/visual-diff/SKILL.md",
    "skill://.kiro/skills/asu-brand/SKILL.md",
    "skill://.kiro/skills/unity-components/SKILL.md",
    "skill://.kiro/skills/asu-design-a11y/SKILL.md"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        ".pipeline/**"
      ],
      "deniedPaths": [
        "packages/**",
        "docroot/**",
        "src/**"
      ]
    }
  },
  "hooks": {
    "agentSpawn": [
      {
        "command": "mkdir -p .pipeline",
        "description": "Ensure pipeline artifact directory exists"
      }
    ]
  },
  "keyboardShortcut": "ctrl+shift+v",
  "welcomeMessage": "Visual-diff agent ready. I compare the rendered component against the design references."
}
