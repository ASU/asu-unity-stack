{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "resolveJsonModule": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/types",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "rootDirs": ["src", "scripts"],
    "module": "esnext",
    "declaration": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "types": ["@vitest/browser-playwright"],
    "paths": {
      "@asu/unity-bootstrap-theme": [ "./../unity-bootstrap-theme" ],
      "@asu/unity-bootstrap-theme/*": [ "./../unity-bootstrap-theme/*" ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "types/**/*",
    "src/vite-env.d.ts",
    "shared/**/*",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "__mocks__"
  ]
}
