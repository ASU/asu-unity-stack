{
  "name": "@asu/component-events",
  "version": "3.1.0",
  "description": "ASU Events component",
  "main": "./dist/asuEvents.cjs.js",
  "browser": "./dist/asuEvents.umd.js",
  "module": "./dist/asuEvents.es.js",
  "types": "./dist/main.d.ts",
  "author": "Nicolas Baudon",
  "license": "MIT",
  "files": [
    "examples/*",
    "dist/*",
    "docs/*",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asu/asu-unity-stack.git",
    "directory": "packages/component-events"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "lint": "eslint --fix 'src/**/*.{js,jsx}' ",
    "test": "vitest --watch=false",
    "test-update-snapshot": "yarn test -- -u",
    "build": "vite build && yarn postbuild",
    "build:stats": "webpack -c webpack/webpack.prod.js --profile --json=compilation-stats.json",
    "postbuild": "cp ./types/main.d.ts ./dist/main.d.ts",
    "start:dev": "webpack-dashboard -- webpack serve -c webpack/webpack.dev.js",
    "storybook": "storybook dev -p 9060",
    "build-storybook": "storybook build -o ../../build/$npm_package_name",
    "jsdoc": "jsdoc -c jsdoc.config.js",
    "predocs": "mkdir -p ./docs",
    "docs": "yarn predocs && jsdoc2md --no-cache -c jsdoc.config.js --files ./src/components > ./docs/README.props.md && yarn postdocs",
    "postdocs": "node ../../scripts/process-readme-props.js"
  },
  "dependencies": {
    "@asu/unity-react-core": "^1.0.0",
    "prop-types": "^15.7.2",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.13.14",
    "@babel/plugin-syntax-jsx": "^7.14.5",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^5.2.4",
    "dotenv-webpack": "^7.0.3",
    "express": "^4.17.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.3.2",
    "http-proxy-middleware": "^2.0.0",
    "jest": "^26.6.3",
    "jest-fetch-mock": "^3.0.3",
    "jest-image-snapshot": "^4.4.1",
    "jest-transform-css": "^6.0.1",
    "jest-transform-file": "^1.1.1",
    "jsdoc": "4",
    "jsdoc-plugin-typescript": "^2.0.6",
    "jsdoc-to-markdown": "^9.0.0",
    "jsdoc-ts-utils": "^2.0.1",
    "jsdom-screenshot": "^4.0.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.0",
    "postcss-loader": "^6.1.1",
    "raw-loader": "^4.0.2",
    "sass": "^1.39.2",
    "sass-loader": "^10",
    "semantic-release": "^22",
    "semantic-release-monorepo": "^8.0.2",
    "storybook": "^10.0.0",
    "style-loader": "^2.0.0",
    "terser-webpack-plugin": "^5.1.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.0",
    "webpack-filter-warnings-plugin": "^1.2.1",
    "webpack-merge": "^5.8.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
