{
  "font": {
    "$description": "Typography tokens. Body sizes use a 1.5 line-height ratio, headings 1.2. Values mirror the current prototype; note the Figma UDS Design Kit defines H1 at 64px desktop / 36px mobile and H2 at 40px / 32px — alignment pending Brand confirmation (UDS-2275).",
    "$extensions": {
      "com.asu.uds": { "status": "experimental" }
    },
    "family": {
      "base": {
        "$value": "Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Body and heading font (per ASU brand guide)",
        "$extensions": {
          "com.asu.uds": { "deprecatedAliases": ["$uds-font-family-base"] }
        }
      }
    },
    "weight": {
      "regular": {
        "$value": "400",
        "$type": "fontWeight",
        "$description": "Regular weight",
        "$extensions": {
          "com.asu.uds": { "deprecatedAliases": ["$uds-font-weight-normal"] }
        }
      },
      "bold": {
        "$value": "700",
        "$type": "fontWeight",
        "$description": "Bold weight",
        "$extensions": {
          "com.asu.uds": { "deprecatedAliases": ["$uds-font-weight-bold"] }
        }
      }
    },
    "size": {
      "xs": {
        "$value": "12px",
        "$type": "dimension",
        "$description": "Extra small body text"
      },
      "sm": {
        "$value": "14px",
        "$type": "dimension",
        "$description": "Small body text"
      },
      "md": {
        "$value": "16px",
        "$type": "dimension",
        "$description": "Default body text"
      },
      "lg": {
        "$value": "18px",
        "$type": "dimension",
        "$description": "Large body text"
      },
      "xl": {
        "$value": "24px",
        "$type": "dimension",
        "$description": "Extra large body text"
      },
      "body": {
        "$value": "{font.size.md}",
        "$type": "dimension",
        "$description": "Default body font size"
      },
      "h1": {
        "xl": {
          "$value": "56px",
          "$type": "dimension",
          "$description": "H1 xl variant"
        },
        "lg": {
          "$value": "36px",
          "$type": "dimension",
          "$description": "H1 large variant"
        },
        "md": {
          "$value": "30px",
          "$type": "dimension",
          "$description": "H1 medium variant"
        },
        "sm": {
          "$value": "24px",
          "$type": "dimension",
          "$description": "H1 small variant"
        }
      },
      "h2": {
        "xl": {
          "$value": "48px",
          "$type": "dimension",
          "$description": "H2 xl variant"
        },
        "lg": {
          "$value": "30px",
          "$type": "dimension",
          "$description": "H2 large variant"
        },
        "md": {
          "$value": "24px",
          "$type": "dimension",
          "$description": "H2 medium variant"
        },
        "sm": {
          "$value": "18px",
          "$type": "dimension",
          "$description": "H2 small variant"
        }
      },
      "h3": {
        "xl": {
          "$value": "30px",
          "$type": "dimension",
          "$description": "H3 xl variant"
        },
        "lg": {
          "desktop": {
            "$value": "24px",
            "$type": "dimension",
            "$description": "H3 large variant on desktop (>=992px)"
          },
          "mobile": {
            "$value": "18px",
            "$type": "dimension",
            "$description": "H3 large variant on mobile (<768px)"
          }
        },
        "md": {
          "$value": "18px",
          "$type": "dimension",
          "$description": "H3 medium variant"
        },
        "sm": {
          "$value": "16px",
          "$type": "dimension",
          "$description": "H3 small variant"
        }
      }
    }
  },
  "line-height": {
    "$description": "Line-height scale paired with the font sizes (1.5 ratio for body, 1.2 for headings).",
    "$extensions": {
      "com.asu.uds": { "status": "experimental" }
    },
