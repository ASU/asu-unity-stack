{
  "radius": {
    "$description": "Border radius scale.",
    "$extensions": {
      "com.asu.uds": { "status": "experimental" }
    },
    "none": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "No rounding"
    },
    "sm": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Subtle rounding (buttons)"
    },
    "md": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Default rounding (cards, inputs)"
    },
    "lg": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Pronounced rounding"
    },
    "xl": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Large rounding (modals, panels)"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Pill/circle shape. The legacy SCSS theme uses 400rem for the same purpose.",
      "$extensions": {
        "com.asu.uds": { "deprecatedAliases": ["$uds-component-border-radius"] }
      }
    }
  }
}
