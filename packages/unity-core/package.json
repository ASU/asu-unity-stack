{
  "name": "@asu/unity-core",
  "version": "1.0.0",
  "type": "module",
  "description": "ASU Unity Design System web components library and global styles. Part of the UDS Code Kit.",
  "main": "dist/unity-core.js",
  "module": "dist/unity-core.js",
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "import": "./dist/unity-core.js",
      "types": "./dist/index.d.ts"
    },
    "./button": {
      "import": "./dist/components/uds-button.js"
    },
    "./accordion": {
      "import": "./dist/components/uds-accordion.js"
    },
    "./card": {
      "import": "./dist/components/uds-card.js"
    },
    "./ga-event-wrapper": {
      "import": "./dist/components/uds-ga-event-wrapper.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6008",
    "analyze": "cem analyze",
    "build": "vite build",
    "build:tailwind": "tailwindcss -i ./src/global/tailwind.css -o ./dist/tailwind.css --minify",
    "build:tokens": "node build-tokens.js",
    "test": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6008",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.0",
    "@lit/reactive-element": "^2.0.0",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/web-components": "^10",
    "@storybook/web-components-vite": "^10",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^9.0.0",
    "lit": "^3.2.0",
    "storybook": "^10",
    "style-dictionary": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/",
    "tokens/",
    "custom-elements.json",
    "README.md"
  ],
  "volta": {
    "extends": "../../package.json"
  }
}
