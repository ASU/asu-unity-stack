              "type": {
                "text": "GaEventType"
              },
              "default": "{}",
              "description": "Google Analytics data applied to the slotted child.",
              "fieldName": "gaData"
            },
            {
              "name": "prefix",
              "type": {
                "text": "GaPrefix"
              },
              "default": "''",
