          "superclass": {
            "name": "UdsBaseElement",
            "module": "/src/core/base-element.js"
          },
          "tagName": "uds-ga-event-wrapper",
          "customElement": true,
          "summary": "Wraps a single slotted element and wires it for Google Analytics\ntracking — the web-component equivalent of the React `GaEventWrapper`.\n\nIt supports the same two mechanisms the design system uses elsewhere:\n\n1. **Declarative (`data-ga*` attributes)** — the wrapper reflects the values\nfrom `gaData` onto the slotted child as `data-ga{prefix}-*` attributes, so\nthe CMS/global `[data-ga]` click listener picks them up. This is the\nprimary mechanism for HTML/Drupal consumption.\n2. **Programmatic (`dataLayer` push)** — on click it also pushes the event\nstraight to `window.dataLayer`, guarded (like the React version) so it only\nfires when `gaData.event` and `gaData.action` are both present."
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "UdsGaEventWrapper",
          "declaration": {
            "name": "UdsGaEventWrapper",
